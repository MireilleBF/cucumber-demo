@startuml
'!theme spacelab

title Context Map - STEats System

' Bounded Contexts
package "Catalog & Menus managment" as Catalog #A9DCDF{
'  [Restaurant]
 ' [Menu]
'  [Dish]
'  [Dish Option]
'  [Capacity]
}


package "Ordering" as Ordering #A9DCDF {
 ' [Order]
 ' [Order Line]
  '[Registered User]
}

package "Paying" as Paying  #A9DCDF{
  '[Payment]
  '[Student Credit]
}

package "Statistics Managment " as Statistics {
  '[Statistics]
}

package "AI" as AI #motivation{
 ' [Photo]
}

package "Identity & Access" as Identity #salmon{
  '[User]
  '[Role]
  '[Permission]
}

' Delivery / Logistics
package "Deliverying" as Delivery #lightgreen {
'  [Delivery]
'  [Courier]
}

' Relations
Identity --> Ordering : Authenticates \n Registered Users
Identity --> Catalog : Authenticates \n Registered Restaurant Owners
Ordering --> Delivery : Requests Delivery for Orders \n and Delivery Status
'Delivery --> Statistics : Traces \n Delivery Performance Data
'Delivery --> Ordering : Provides \n Delivery Status
'Ordering --> Delivery : Requests Delivery Status
Catalog --> Ordering : Provides \n Menus & Capacities
Ordering --> Paying : Provides Amount\n & Order State
Paying --> Ordering : "Validates\n Payment Success"
Ordering --> Statistics : "Traces\n OrderValidated \n & OrderDelivered"
'Ordering --> Statistics : "Traces\n OrderDelivered"
Paying --> Statistics : "Traces\n PaymentSucceeded"
Catalog <-- AI : Provides Photo Analysis \n and Plating Suggestions



@enduml


